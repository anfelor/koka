// Borrowed comparisons must handle both operand orders and bigint inputs.
noinline fun classify(^x : int) : list<bool>
  [x == 0,
   0 == x,
   x != 0,
   0 != x,
   x == 1,
   1 == x,
   x != 1,
   1 != x,
   x == (-1),
   (-1) == x,
   x != (-1),
   (-1) != x,
   x == 8191,
   8191 == x,
   x != 8191,
   8191 != x,
   x == (-8192),
   (-8192) == x,
   x != (-8192),
   (-8192) != x,
   x == 8192,
   8192 == x,
   x != 8192,
   8192 != x,
   x == 10000000000000000000000000000000000000000,
   10000000000000000000000000000000000000000 == x,
   x != 10000000000000000000000000000000000000000,
   10000000000000000000000000000000000000000 != x]

fun main()
  [-10000000000000000000000000000000000000000, -8193, -8192, -1, 0, 1, 8191, 8192, 10000000000000000000000000000000000000000].foreach fn(x)
    classify(x).map(fn(b) b.show).join(",").println
